<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HimVote.Core.ViewModels;assembly=HimVote.Core"
             xmlns:models="clr-namespace:HimVote.Core.Models;assembly=HimVote.Core"
             xmlns:converters="clr-namespace:HimVote.Linux.Converters"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="1100"
             x:DataType="vm:AdminViewModel"
             x:Class="HimVote.Linux.Views.AdminPage"
             UseLayoutRounding="True">

    <StackPanel Spacing="22">
        <!-- Header -->
        <Border Classes="card" Background="{StaticResource SurfaceBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Administrative Lifecycle Console" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" />
                <TextBlock Text="Institutional registrar controls: draft contest creation, cryptographic roster freeze, casting window management, and results publication."
                           Foreground="#475569" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Clean Error State Display -->
        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static converters:NullOrEmptyToBoolConverter.NotEmpty}}"
                Classes="error_state">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#EF4444" VerticalAlignment="Top">
                    <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Administrative Action Error" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Red600Brush}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#7F1D1D" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Message -->
        <Border IsVisible="{Binding StatusMessage, Converter={x:Static converters:NullOrEmptyToBoolConverter.NotEmpty}}"
                Classes="info_state">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#0369A1" FontWeight="Medium" TextWrapping="Wrap" />
        </Border>

        <!-- Create Election Draft Card -->
        <Border Classes="card">
            <StackPanel Spacing="16">
                <TextBlock Text="Draft New Election Contest" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />

                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Election Title:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewElectionTitle}"
                             Watermark="Example: 2026 Student Government President"
                             Classes="input_field" TabIndex="90" MinHeight="44"
                             AutomationProperties.Name="New Election Title Input" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Contest Name:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Contest}"
                             Watermark="Example: President"
                             Classes="input_field" TabIndex="91" MinHeight="44"
                             AutomationProperties.Name="Contest Name Input" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Anonymous Turnout:" VerticalAlignment="Center" FontWeight="Medium" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MinAnonymousTurnout}"
                                   Minimum="5" Maximum="1000" MinHeight="44" TabIndex="92"
                                   AutomationProperties.Name="Minimum Anonymous Turnout Input" />
                </Grid>

                <Button Content="Create Draft Election" Command="{Binding CreateElectionCommand}"
                        Classes="primary_button" MinHeight="44" TabIndex="93"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Create Draft Election Action" />
            </StackPanel>
        </Border>

        <!-- Managed Elections List & Lifecycle Actions -->
        <Border Classes="card">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Election Lifecycle Management" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshElectionsCommand}"
                            Classes="secondary_button" MinHeight="40" TabIndex="94"
                            AutomationProperties.Name="Refresh Managed Elections Action" />
                </Grid>

                <!-- Empty State -->
                <Border Classes="empty_state" IsVisible="{Binding ManagedElections, Converter={x:Static converters:NullOrEmptyToBoolConverter.Empty}}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="No Managed Elections" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Create a draft election above or select Refresh to load existing institutional elections." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Items -->
                <ItemsControl ItemsSource="{Binding ManagedElections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ElectionSummary">
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14" Background="#FAFAFA">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" />

                                    <Border Grid.Row="0" Grid.Column="1" Classes="badge"
                                            Background="{Binding State, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=background}"
                                            BorderBrush="{Binding State, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=border}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding State}" FontWeight="Bold" FontSize="11"
                                                   Foreground="{Binding State, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=foreground}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Id, StringFormat='Contest ID: {0}'}" Classes="code_text" Foreground="#64748B" />

                                    <!-- Lifecycle Action Buttons -->
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="Freeze Roster"
                                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).FreezeElectionCommand}"
                                                CommandParameter="{Binding Id}"
                                                Classes="secondary_button" MinHeight="40"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Freeze Roster for {0}'}" />
                                        <Button Content="Open Election"
                                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).OpenElectionCommand}"
                                                CommandParameter="{Binding Id}"
                                                Classes="primary_button" MinHeight="40"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Open Election for {0}'}" />
                                        <Button Content="Close Election"
                                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).CloseElectionCommand}"
                                                CommandParameter="{Binding Id}"
                                                Classes="secondary_button" MinHeight="40"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Close Election for {0}'}" />
                                        <Button Content="Publish Results"
                                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).RequestPublicationCommand}"
                                                CommandParameter="{Binding Id}"
                                                Classes="primary_button" MinHeight="40"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Publish Results for {0}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
