<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HimVote.Core.ViewModels;assembly=HimVote.Core"
             xmlns:converters="clr-namespace:HimVote.Linux.Converters"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="750"
             x:DataType="vm:LoginViewModel"
             x:Class="HimVote.Linux.Views.LoginPage"
             UseLayoutRounding="True">

    <Grid RowDefinitions="Auto,*" Margin="30">
        <Border Grid.Row="0" Classes="card" Padding="32" MaxWidth="460" HorizontalAlignment="Center">
            <StackPanel Spacing="18">
                <!-- Branding Header -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Sign in to HimVote" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource Navy900Brush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Institutional University SSO and Credential Authentication"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Authenticated Active Session Card -->
                <Border IsVisible="{Binding IsLoggedIn}" Classes="success_state">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Authenticated Session Active" FontWeight="Bold" Foreground="{StaticResource Green600Brush}" />
                            <Border Grid.Column="1" Classes="badge" Background="{StaticResource Green100Brush}" BorderBrush="#86EFAC" BorderThickness="1">
                                <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Green600Brush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CurrentUser.FullName, StringFormat='Full Name: {0}'}" FontSize="13" Foreground="#065F46" />
                        <TextBlock Text="{Binding CurrentUser.Email, StringFormat='Institutional Email: {0}'}" FontSize="13" Foreground="#065F46" />
                        <TextBlock Text="{Binding CurrentUser.Role, StringFormat='Role: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#065F46" />
                        <Button Content="Sign Out"
                                Command="{Binding LogoutCommand}"
                                Classes="secondary_button"
                                MinHeight="44"
                                TabIndex="65"
                                Margin="0,8,0,0"
                                AutomationProperties.Name="Sign Out Action" />
                    </StackPanel>
                </Border>

                <!-- Clean Error State Display -->
                <Border IsVisible="{Binding ErrorMessage, Converter={x:Static converters:NullOrEmptyToBoolConverter.NotEmpty}}"
                        Classes="error_state">
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#EF4444" VerticalAlignment="Top">
                            <TextBlock Text="!" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Authentication Error" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Red600Brush}" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status Feedback Message -->
                <Border IsVisible="{Binding StatusMessage, Converter={x:Static converters:NullOrEmptyToBoolConverter.NotEmpty}}"
                        Classes="info_state">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#0369A1" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Sign In Form (Visible when not authenticated) -->
                <StackPanel Spacing="14" IsVisible="{Binding !IsLoggedIn}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Institutional Email:" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                        <TextBox Text="{Binding Email}"
                                 Watermark="student@university.edu"
                                 MinHeight="44"
                                 Classes="input_field"
                                 TabIndex="60"
                                 AutomationProperties.Name="Institutional Email Input" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Password:" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                        <TextBox Text="{Binding Password}"
                                 PasswordChar="•"
                                 Watermark="Enter institutional password"
                                 MinHeight="44"
                                 Classes="input_field"
                                 TabIndex="61"
                                 AutomationProperties.Name="Password Input" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="MFA Token (Optional):" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                        <TextBox Text="{Binding MfaToken}"
                                 Watermark="6 digit authentication code"
                                 MinHeight="44"
                                 Classes="input_field"
                                 TabIndex="62"
                                 AutomationProperties.Name="MFA Token Input" />
                    </StackPanel>

                    <Button Content="Sign In"
                            Command="{Binding LoginCommand}"
                            MinHeight="44"
                            Classes="primary_button"
                            IsEnabled="{Binding !IsBusy}"
                            TabIndex="63"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Sign In Action" />

                    <Button Content="Restore Saved Session"
                            Command="{Binding RestoreSavedSessionCommand}"
                            MinHeight="44"
                            Classes="secondary_button"
                            IsEnabled="{Binding !IsBusy}"
                            TabIndex="64"
                            AutomationProperties.Name="Restore Saved Session Action" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
