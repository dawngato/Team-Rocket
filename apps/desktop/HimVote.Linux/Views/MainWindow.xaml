<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HimVote.Linux.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="HimVote.Linux.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HimVote Institutional Election Platform"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="260,*" RowDefinitions="64,*">
        <!-- Sidebar Navigation -->
        <Border Grid.Row="0" Grid.RowSpan="2" Classes="sidebar">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="HimVote" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" Margin="8,8,8,20" />

                    <Button Content="Sign In" Command="{Binding NavigateToCommand}" CommandParameter="login"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Elections" Command="{Binding NavigateToCommand}" CommandParameter="elections"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Candidates" Command="{Binding NavigateToCommand}" CommandParameter="candidates"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Receipt Verification" Command="{Binding NavigateToCommand}" CommandParameter="receipt"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Evidence Import" Command="{Binding NavigateToCommand}" CommandParameter="evidence"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Audit Explorer" Command="{Binding NavigateToCommand}" CommandParameter="audit"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Admin Console" Command="{Binding NavigateToCommand}" CommandParameter="admin"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="Settings" Command="{Binding NavigateToCommand}" CommandParameter="settings"
                            Classes="nav-button" HorizontalAlignment="Stretch" MinHeight="44" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0,8,8">
                    <Separator Margin="0,0,0,12" Background="#CBD5E1" />
                    <TextBlock Text="Institutional Edition v2.0" FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="Windows &amp; Linux Supported" FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Grid.Column="1" Classes="topbar">
            <Grid ColumnDefinitions="*,Auto" Margin="24,0">
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{StaticResource Navy900Brush}" />
                <TextBlock Grid.Column="1" Text="Offline Ready" FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Foreground="{StaticResource Green600Brush}" />
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="24" />
        </ScrollViewer>
    </Grid>
</Window>
