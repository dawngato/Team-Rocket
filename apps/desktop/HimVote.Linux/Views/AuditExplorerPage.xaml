<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HimVote.Core.ViewModels;assembly=HimVote.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:AuditExplorerViewModel"
             x:Class="HimVote.Linux.Views.AuditExplorerPage">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <TextBlock Text="Offline Audit Explorer" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" />
            <TextBlock Text="Verify election evidence without network access." Foreground="#666666" />
        </StackPanel>

        <Border Classes="card" Padding="20" DockPanel.Dock="Top" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Evidence archive path:" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EvidencePath}" Watermark="Select evidence archive" MinHeight="44" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Trust pins path:" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TrustPinsPath}" Watermark="Select trust pins file" MinHeight="44" />

                <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Run Verification" 
                        Command="{Binding RunVerificationCommand}" MinHeight="44"
                        Classes="primary-button" IsEnabled="{Binding !IsLoading}" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <Border IsVisible="{Binding Report, Converter={x:Static ObjectToBoolConverter.IsNotNull}}" 
                Classes="card" Padding="20" DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Verification Report" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding VerifierSha256, StringFormat='Verifier SHA256: {0}'}" FontFamily="monospace" FontSize="12" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Teal600Brush}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>