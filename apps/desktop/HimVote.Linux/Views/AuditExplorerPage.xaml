<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HimVote.Core.ViewModels;assembly=HimVote.Core"
             xmlns:models="clr-namespace:HimVote.Core.Models;assembly=HimVote.Core"
             xmlns:converters="clr-namespace:HimVote.Linux.Converters"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="1400"
             x:DataType="vm:AuditExplorerViewModel"
             x:Class="HimVote.Linux.Views.AuditExplorerPage"
             UseLayoutRounding="True">

    <StackPanel Spacing="22">
        <!-- Page Header -->
        <Border Classes="card" Background="{StaticResource SurfaceBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Offline Cryptographic Audit Explorer" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" />
                        <TextBlock Text="Inspect Merkle history, anonymous credential evidence, roster attestations, tally proofs, and configured chain evidence from local files."
                                   Foreground="#475569" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="badge" Background="#E0E7FF" BorderBrush="#C7D2FE" BorderThickness="1">
                        <TextBlock Text="Local Evidence Mode" FontSize="11" FontWeight="Bold" Foreground="#3730A3" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Audit Trail Stepper Visualization -->
        <Border Classes="card" Background="#FFFFFF">
            <StackPanel Spacing="14">
                <TextBlock Text="Audit Verification Stages" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <!-- Stage 1 -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Navy900Brush}">
                                    <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Trust Root" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy900Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Manifest digest and authority pin loading" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Stage 2 -->
                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Navy900Brush}">
                                    <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tree Integrity" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy900Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="RFC 9162 Merkle log proof recomputation" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Stage 3 -->
                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Navy900Brush}">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Credentials" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy900Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Blind signature and nullifier uniqueness" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Stage 4 -->
                    <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Navy900Brush}">
                                    <TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tally Proof" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy900Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Homomorphic tally and ballot count check" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Stage 5 -->
                    <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Navy900Brush}">
                                    <TextBlock Text="5" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Consensus" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy900Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Consortium anchor and finality verification" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Verification Parameters and Sandbox Settings -->
        <Border Classes="card">
            <StackPanel Spacing="16">
                <TextBlock Text="Verification Inputs &amp; Process Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />

                <Grid ColumnDefinitions="210,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Evidence Directory:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EvidenceDirectoryPath}"
                             Watermark="Path to extracted election evidence folder"
                             Classes="input_field" TabIndex="10" MinHeight="44"
                             AutomationProperties.Name="Evidence Directory Path Input" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="External Trust Pins:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TrustPinsFilePath}"
                             Watermark="Path to external trust pins JSON file"
                             Classes="input_field" TabIndex="11" MinHeight="44"
                             AutomationProperties.Name="External Trust Pins File Path Input" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Verifier Binary / Script:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VerifierScriptPath}"
                             Watermark="Path to verify.py or standalone verifier executable"
                             Classes="input_field" TabIndex="12" MinHeight="44"
                             AutomationProperties.Name="Verifier Script Path Input" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected SHA256 Checksum:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedVerifierChecksum}"
                             Watermark="Optional SHA256 hex digest for integrity gate check"
                             Classes="input_field" TabIndex="13" MinHeight="44"
                             AutomationProperties.Name="Expected Verifier SHA256 Checksum Input" />
                </Grid>

                <!-- Action Toolbar with Accessibility -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Content="Execute Independent Verification"
                            Command="{Binding RunVerificationCommand}"
                            Classes="primary_button"
                            TabIndex="14"
                            MinHeight="44"
                            MinWidth="240"
                            AutomationProperties.Name="Execute Verification Action" />
                    <Button Content="Clear Verification Results"
                            Command="{Binding ResetCommand}"
                            Classes="secondary_button"
                            TabIndex="15"
                            MinHeight="44"
                            AutomationProperties.Name="Clear Results Action" />
                </StackPanel>

                <!-- In Progress Loading State -->
                <StackPanel Spacing="8" IsVisible="{Binding IsVerifying}" Margin="0,8,0,0">
                    <ProgressBar IsIndeterminate="True" MinHeight="6" />
                    <TextBlock Text="Running the checked verifier process; network isolation is not enforced by this client..." FontSize="13" Foreground="{StaticResource Teal600Brush}" FontWeight="Medium" />
                </StackPanel>

                <!-- Clean Error State Display -->
                <Border IsVisible="{Binding ErrorMessage, Converter={x:Static converters:NullOrEmptyToBoolConverter.NotEmpty}}"
                        Classes="error_state">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#EF4444" VerticalAlignment="Top">
                            <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Cryptographic Verification Error" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Red600Brush}" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#7F1D1D" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Troubleshooting hint: Confirm external trust pins file exists and verifier SHA256 digest matches expectation."
                                       FontSize="11" Foreground="#991B1B" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status Feedback Message -->
                <Border IsVisible="{Binding StatusMessage, Converter={x:Static converters:NullOrEmptyToBoolConverter.NotEmpty}}"
                        Classes="info_state">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#0369A1" FontWeight="Medium" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Initial Guidance Empty State (Shown before verification has executed) -->
        <Border Classes="empty_state" IsVisible="{Binding !VerificationCompleted}">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#EEF2FF" VerticalAlignment="Top">
                    <TextBlock Text="ℹ" FontSize="18" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Ready for Offline Verification" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Navy900Brush}" />
                    <TextBlock Text="Provide the path to your extracted election evidence directory and separately obtained trust pins file above. The verifier reads local evidence; this client does not provide OS-level network isolation."
                               FontSize="13" Foreground="#475569" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Verification Results Workspace (Visible after execution completes) -->
        <StackPanel Spacing="22" IsVisible="{Binding VerificationCompleted}">

            <!-- Overall Outcome Banner -->
            <Border Classes="card" Background="#F8FAFC">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Verification Execution Outcome" FontSize="13" Foreground="#64748B" FontWeight="Medium" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Classes="badge"
                                    Background="{Binding OverallStatus, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=background}"
                                    BorderBrush="{Binding OverallStatus, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=border}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding OverallStatus, Converter={x:Static converters:StatusToIconConverter.Instance}}"
                                           Foreground="{Binding OverallStatus, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=foreground}"
                                           FontWeight="Bold" FontSize="13" />
                            </Border>
                            <TextBlock Text="{Binding ExitCode, StringFormat='Process Exit Code: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Verifier Checksum:" FontSize="12" Foreground="#64748B" FontWeight="Medium" />
                            <TextBlock Text="{Binding ActualVerifierChecksum}" FontFamily="monospace" FontSize="12" Foreground="#0F172A" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Side by Side Merkle Root Verification Card -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Merkle Root Integrity (RFC 9162)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />
                        <Border Grid.Column="1" Classes="badge"
                                Background="{Binding RootsMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#DCFCE7|#FEE2E2'}"
                                BorderBrush="{Binding RootsMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#86EFAC|#FCA5A5'}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding RootsMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='✓ ROOTS MATCH|✕ ROOT MISMATCH'}"
                                       Foreground="{Binding RootsMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#15805D|#C23C45'}"
                                       FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Published Root -->
                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Published Witness Merkle Root:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <TextBlock Text="{Binding PublishedRoot}" Classes="code_text" />
                            </StackPanel>
                        </Border>

                        <!-- Computed Root -->
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Computed RFC 9162 Merkle Root:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <TextBlock Text="{Binding ComputedRoot}" Classes="code_text" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Side by Side Tally Verification Card -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Ballot Tally Cryptographic Verification" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />
                        <Border Grid.Column="1" Classes="badge"
                                Background="{Binding TalliesMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#DCFCE7|#FEE2E2'}"
                                BorderBrush="{Binding TalliesMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#86EFAC|#FCA5A5'}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding TalliesMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='✓ TALLY MATCH|✕ TALLY DISCREPANCY'}"
                                       Foreground="{Binding TalliesMatch, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#15805D|#C23C45'}"
                                       FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Published Ballot Count:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <TextBlock Text="{Binding PublishedTotalBallots}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Computed Valid Ballot Count:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <TextBlock Text="{Binding ComputedTotalBallots}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Candidate Breakdown Comparison Table -->
                    <TextBlock Text="Candidate Breakdown Comparison" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,8,0,0" />
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <!-- Table Header -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnDefinitions="160,*,120,120,120">
                                    <TextBlock Grid.Column="0" Text="Candidate ID" FontWeight="Bold" FontSize="12" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="Candidate Name" FontWeight="Bold" FontSize="12" Foreground="#475569" />
                                    <TextBlock Grid.Column="2" Text="Published Votes" FontWeight="Bold" FontSize="12" Foreground="#475569" />
                                    <TextBlock Grid.Column="3" Text="Computed Votes" FontWeight="Bold" FontSize="12" Foreground="#475569" />
                                    <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ItemsControl ItemsSource="{Binding CandidateTallyComparisons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CandidateTallyItem">
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10" Background="#FFFFFF">
                                            <Grid ColumnDefinitions="160,*,120,120,120">
                                                <TextBlock Grid.Column="0" Text="{Binding CandidateId}" FontFamily="monospace" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding CandidateName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding PublishedVotes}" VerticalAlignment="Center" FontSize="13" />
                                                <TextBlock Grid.Column="3" Text="{Binding ComputedVotes}" VerticalAlignment="Center" FontSize="13" />
                                                <Border Grid.Column="4" Classes="badge" HorizontalAlignment="Right"
                                                        Background="{Binding Matches, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#DCFCE7|#FEE2E2'}"
                                                        BorderBrush="{Binding Matches, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#86EFAC|#FCA5A5'}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Matches, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='MATCH|MISMATCH'}"
                                                               Foreground="{Binding Matches, Converter={x:Static converters:BoolToStringConverter.TrueFalse}, ConverterParameter='#15805D|#C23C45'}"
                                                               FontWeight="Bold" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Evaluated Cryptographic Properties Evaluation Card with Badges -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Evaluated Cryptographic &amp; Security Properties" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />
                            <TextBlock Text="Individual assessment of all mandatory verification properties per election specifications." Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VerificationPropertyItem">
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="14">
                                    <Grid ColumnDefinitions="260,130,160,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{Binding PropertyName}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Navy900Brush}" />

                                        <!-- Verification Status Badge -->
                                        <Border Grid.Column="1" Classes="badge"
                                                Background="{Binding Status, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=background}"
                                                BorderBrush="{Binding Status, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=border}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Status, Converter={x:Static converters:StatusToIconConverter.Instance}}"
                                                       Foreground="{Binding Status, Converter={x:Static converters:StatusToBrushConverter.Instance}, ConverterParameter=foreground}"
                                                       FontWeight="Bold" FontSize="11" />
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding FailureCode}" FontFamily="monospace" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Deterministic Report Exporting Card -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Export Deterministic Verification Reports" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Navy900Brush}" />
                    <TextBlock Text="Export canonical RFC 8785 JSON or formatted plain text reports including verifier checksums for institutional audits." Foreground="#64748B" FontSize="12" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Export JSON Report"
                                Command="{Binding ExportJsonReportCommand}"
                                Classes="primary_button"
                                TabIndex="20"
                                MinHeight="44"
                                AutomationProperties.Name="Export JSON Report Action" />
                        <Button Content="Export Plain Text Report"
                                Command="{Binding ExportTextReportCommand}"
                                Classes="secondary_button"
                                TabIndex="21"
                                MinHeight="44"
                                AutomationProperties.Name="Export Text Report Action" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
