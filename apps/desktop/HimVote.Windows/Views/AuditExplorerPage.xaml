<Page
    x:Class="HimVote.Windows.Views.AuditExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HimVote.Windows.Models"
    xmlns:vm="using:HimVote.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Offline Audit Explorer" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Independent verification engine runner and cryptographic proof evaluator"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="16"
                CornerRadius="8">
            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         Header="Evidence Export Directory"
                         Text="{x:Bind ViewModel.EvidenceDirectoryPath, Mode=TwoWay}"
                         PlaceholderText="/path/to/extracted/evidence" />

                <TextBox Grid.Row="0" Grid.Column="1"
                         Header="Trust Pins File"
                         Text="{x:Bind ViewModel.TrustPinsFilePath, Mode=TwoWay}"
                         PlaceholderText="/path/to/pinned_trust.json" />

                <TextBox Grid.Row="0" Grid.Column="2"
                         Header="Verifier Script or Executable"
                         Text="{x:Bind ViewModel.VerifierScriptPath, Mode=TwoWay}"
                         PlaceholderText="verifier/verify.py" />

                <Button Grid.Row="0" Grid.Column="3"
                        Content="Run Audit Verification"
                        Command="{x:Bind ViewModel.RunVerificationCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Bottom" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Expected SHA256:" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind ViewModel.ExpectedVerifierChecksum, Mode=TwoWay}" Width="280" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Actual Checksum:" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ActualVerifierChecksum, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Button Content="Export JSON Report" Command="{x:Bind ViewModel.ExportJsonReportCommand}" />
                    <Button Content="Export Text Report" Command="{x:Bind ViewModel.ExportTextReportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Pivot Grid.Row="2">
            <PivotItem Header="Properties Verification">
                <ListView ItemsSource="{x:Bind ViewModel.Properties, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VerificationPropertyItem">
                            <Grid Padding="12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind PropertyName}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Status}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind FailureCode}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="Side by Side Root &amp; Tally Comparison">
                <ScrollViewer>
                    <StackPanel Spacing="24" Padding="12">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="16"
                                CornerRadius="8">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Merkle Root Comparison" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Published Merkle Root:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PublishedRoot, Mode=OneWay}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Computed Merkle Root:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ComputedRoot, Mode=OneWay}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Comparison Result:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.RootsMatch, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="16"
                                CornerRadius="8">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Tally Total and Candidate Comparison" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Published Total Ballots:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PublishedTotalBallots, Mode=OneWay}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Computed Total Ballots:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ComputedTotalBallots, Mode=OneWay}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Totals Match:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.TalliesMatch, Mode=OneWay}" />
                                </Grid>

                                <ListView ItemsSource="{x:Bind ViewModel.CandidateTallyComparisons, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CandidateTallyItem">
                                            <Grid Padding="8" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind CandidateName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind PublishedVotes}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ComputedVotes}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Matches}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
