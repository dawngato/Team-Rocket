# ==============================================================================
# Campus Vault - Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs & Caches
.next/
out/
build/
dist/
.turbo/

# Environment Variables & Secrets
.env
.env*.local
.env.production
.env.staging

# Explicitly track the example template
!.env.example

# Local SQLite Database & Journal Files
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal

# Private Cryptographic Keys & Sensitive Credentials
# (Never commit private signing keys to version control)
keys/*_private*
keys/*.pem
*.key
*.pfx
*.p12

# Explicitly allow public verification keys to be tracked
!keys/*_public_key.pem
!artifacts/**/trusted_auditor_public_key.pem

# Debug Logs & Error Reports
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS-generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.swn
*~
*.bak

# Testing & Coverage
coverage/
.nyc_output/

# Temporary and Scratch Dirs
tmp/
temp/
.cache/
