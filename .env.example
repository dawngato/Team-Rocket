# ============================================================
# HimVote Environment Configuration Template
# Production Grade Institutional Election Platform
# Copy this file to .env and provide real credentials per deployment.
# Never commit actual secret tokens or credentials to version control.
# ============================================================

# Application and Runtime
# Controls the runtime environment tier and logging verbosity.
# Format: local, staging, production
APP_ENV=local
# Toggles debug diagnostics. Must be false in production environments.
APP_DEBUG=false
# Semantic version identifier of the deployed HimVote suite.
APP_VERSION=2.0.0

# Edge Gateway and Reverse Proxy
# The unified entry point routing traffic between identity and casting origins.
GATEWAY_HOST=localhost
GATEWAY_PORT=8080
GATEWAY_TLS_ENABLED=false
# SSL certificate and key paths for production TLS termination.
SSL_CERTIFICATE_PATH=/etc/ssl/certs/himvote_gateway.crt
SSL_KEY_PATH=/etc/ssl/private/himvote_gateway.key
# Comma separated list of allowed HTTP origins for CORS policy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CASTING_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Identity Service and Cluster (Identity Origin)
# Dedicated PostgreSQL cluster storing users, credentials, and signed roster snapshots.
# Strictly isolated from the casting database.
IDENTITY_API_BASE=http://localhost:8081
IDENTITY_DB_HOST=identity_db
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=himvote_identity
IDENTITY_DB_USER=himvote_identity
IDENTITY_DB_PASSWORD=CHANGE_ME_IDENTITY_DB_PASSWORD
# PostgreSQL SSL mode: disable, prefer, require, verify_ca, verify_full
IDENTITY_DB_SSL_MODE=prefer
# Allows initial creation of super administrator. Automatically revoked after first use.
BOOTSTRAP_ALLOWED=false
# Cookie identifier for identity sessions.
SESSION_COOKIE_NAME=himvote_identity_session
# Key derivation parameters for Argon2id user password hashing.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Casting Service and Cluster (Casting Origin)
# Dedicated PostgreSQL cluster storing encrypted ballots, nullifiers, and checkpoints.
# Never stores personal data or student identifiers.
CASTING_API_BASE=http://localhost:8082
CASTING_DB_HOST=casting_db
CASTING_DB_PORT=5432
CASTING_DB_NAME=himvote_casting
CASTING_DB_USER=himvote_casting
CASTING_DB_PASSWORD=CHANGE_ME_CASTING_DB_PASSWORD
# PostgreSQL SSL mode: disable, prefer, require, verify_ca, verify_full
CASTING_DB_SSL_MODE=prefer
# Backlog threshold for unwitnessed ballots before temporarily pausing intake.
CASTING_UNWITNESSED_BACKLOG_MAX=500

# Admin API Service
# Manages election definitions, roster approvals, freeze manifest, and publication gate.
ADMIN_API_BASE=http://localhost:8083
# Fingerprint of authorized independent auditor public key for publication signoff.
AUDITOR_PUBLIC_KEY_FINGERPRINT=CHANGE_ME_SHA256_FINGERPRINT
AUDITOR_PUBLIC_KEY=CHANGE_ME_PEM_ENCODED_PUBLIC_KEY

# Election Engine Adapter
# Adapter connecting the HimVote core with the vetted cryptographic voting engine.
ELECTION_ENGINE_BASE=http://localhost:8084
# Name of the vetted engine provider implementation.
VOTING_ENGINE_PROVIDER=CHANGE_ME_ENGINE_NAME
# Timeout in seconds for cryptographic ballot encryption verification.
ENGINE_TIMEOUT_SECONDS=30

# Checkpoint Worker Service
# Sequential reader creating Merkle tree leaves and publishing checkpoints to witness.
CHECKPOINT_WORKER_BASE=http://localhost:8085
CHECKPOINT_INTERVAL_SECONDS=15
CHECKPOINT_BATCH_SIZE=100

# Witness Service
# Independently operated audit log verification and cosigning service.
WITNESS_BASE=http://localhost:8086
WITNESS_PUBLIC_KEY=CHANGE_ME_WITNESS_PUBLIC_KEY
WITNESS_KEY_ID=CHANGE_ME_WITNESS_KEY_ID
WITNESS_LAG_TOLERANCE_SECONDS=60

# Anchor Relayer Service
# Transaction manager relaying witnessed final digests to the EVM blockchain contract.
ANCHOR_RELAYER_BASE=http://localhost:8087
ANCHOR_RELAYER_KEY_ID=CHANGE_ME_RELAYER_KEY_ID
# Maximum permitted transaction gas spending limit in wei.
ANCHOR_RELAYER_SPENDING_LIMIT=CHANGE_ME_MAX_WEI_SPEND

# Blockchain and Smart Contracts
# EVM compatible network configuration for HimVoteAnchor contract commitment.
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
# Deployed contract address of HimVoteAnchor.
CHAIN_CONTRACT_ADDRESS=CHANGE_ME_0x_CONTRACT_ADDRESS
# Bytecode hash of the verified smart contract.
CHAIN_CODE_HASH=CHANGE_ME_CONTRACT_BYTECODE_SHA256
# Required number of block confirmations to achieve immutable finality.
CHAIN_FINALITY_CONFIRMATIONS=12

# Redis Cache and Event Queue
# High performance non authoritative ephemeral storage.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Identity Provider Federation (OIDC and SAML)
# Institutional single sign on federation endpoints.
OIDC_ISSUER_URL=CHANGE_ME_OIDC_ISSUER_URL
OIDC_CLIENT_ID=CHANGE_ME_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
SAML_METADATA_URL=CHANGE_ME_SAML_METADATA_URL
SAML_ENTITY_ID=CHANGE_ME_SAML_ENTITY_ID

# Multi Factor Authentication (MFA)
# TOTP time step and rate limiting settings for administrative roles.
MFA_ISSUER=HimVote
MFA_WINDOW=1
MFA_RATE_LIMIT=5

# Observability and Telemetry
# Structured logging, metrics export, and automatic token redaction.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true

# Key Management Service (KMS) and Hardware Security Module (HSM)
# Production cryptographic keys must reside in secure hardware modules.
KMS_PROVIDER=CHANGE_ME_KMS_PROVIDER
KMS_KEY_RING=CHANGE_ME_KEY_RING_NAME
KMS_KEY_LOCATION=CHANGE_ME_REGION
KMS_KEY_RING_ID=CHANGE_ME_RING_RESOURCE_ID
KMS_BLIND_SIGNING_KEY_ID=CHANGE_ME_BLIND_SIGNING_KEY_ID

# Standalone Verifier and Trust Configuration
# Path to trusted authority root keys kept outside the election archive.
TRUST_PINS_PATH=CHANGE_ME_PATH_TO_TRUST_PINS_JSON
# Verification CLI script and expected SHA256 integrity digest.
VERIFIER_PATH=./verifier/verify.py
VERIFIER_SHA256=CHANGE_ME_VERIFIER_BINARY_SHA256

# Web Client (Next.js)
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_IDENTITY_BASE=http://localhost:8080
NEXT_PUBLIC_CASTING_BASE=http://localhost:8080
NEXT_PUBLIC_DEV_MODE=false

# Android Client
ANDROID_SIGNING_KEYSTORE=CHANGE_ME_PATH_TO_KEYSTORE
ANDROID_SIGNING_ALIAS=CHANGE_ME_KEYSTORE_ALIAS
ANDROID_PLAY_INTEGRITY_KEY=CHANGE_ME_PLAY_INTEGRITY_KEY

# iOS Client
IOS_TEAM_ID=CHANGE_ME_APPLE_TEAM_ID
IOS_CODE_SIGN_IDENTITY=CHANGE_ME_CODE_SIGN_IDENTITY

# Windows Desktop Client
DESKTOP_CODE_SIGN_CERT=CHANGE_ME_PATH_TO_AUTHENTICODE_CERT
DESKTOP_UPDATE_CHANNEL=CHANGE_ME_UPDATE_CHANNEL

# Election Lifecycle Parameters and Thresholds
# Minimum eligible voter turnout required to prevent anonymity reduction.
ELECTION_MIN_ANONYMOUS_TURNOUT=10
# Warning threshold when turnout is low enough to risk group deanonymization.
ELECTION_PRIVACY_LIMITED_THRESHOLD=5

# Scheduled Election Windows in UTC
# Credential issuance window boundaries.
ISSUANCE_WINDOW_START=CHANGE_ME_ISO_TIMESTAMP_UTC
ISSUANCE_WINDOW_CUTOFF=CHANGE_ME_ISO_TIMESTAMP_UTC
# Ballot casting voting window boundaries.
ELECTION_OPEN_AT_UTC=CHANGE_ME_ISO_TIMESTAMP_UTC
ELECTION_CLOSE_AT_UTC=CHANGE_ME_ISO_TIMESTAMP_UTC
