{
  "name": "himvote_orchestrator",
  "version": "2.0.0",
  "description": "HimVote institutional election platform and Campus Vault suite",
  "private": true,
  "scripts": {
    "verify_integrations": "python3 tools/verify_integrations.py",
    "verify_env": "python3 tools/env_loader.py check",
    "generate_env": "python3 tools/env_loader.py generate_dev",
    "test_tools": "python3 -m unittest discover tests/unit",
    "test_all": "python3 tests/run_tests.py",
    "dev_up": "docker compose up",
    "dev_down": "docker compose down",
    "help": "make help",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "prisma db push --force-reset && node scripts/seed.mjs",
    "test:security": "node scripts/run-security-tests.mjs",
    "verify": "python3 scripts/verify_election.py"
  },
  "keywords": [
    "himvote",
    "elections",
    "voting",
    "orchestrator",
    "campus-vault"
  ],
  "author": "HimVote Core Architecture Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
